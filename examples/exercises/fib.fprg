<?xml version="1.0"?>
<flowgorithm fileversion="3.0">
    <attributes>
        <attribute name="name" value="Fibonacci"/>
        <attribute name="authors" value="alekseitatuzov"/>
        <attribute name="about" value="Fibonacci.&#13;&#10;&#13;&#10;The Fibonacci numbers, with a loop and with recursion."/>
        <attribute name="saved" value="2026-10-30 08:24:29 PM"/>
        <attribute name="created" value="YWxla3NlaXRhdHV6b3Y7QWxla3NlaXMtTWFjQm9vay1Qcm87MjAyNi0xMC0zMDswODoyNDoyOSBQTTsw"/>
        <attribute name="edited" value="YWxla3NlaXRhdHV6b3Y7QWxla3NlaXMtTWFjQm9vay1Qcm87MjAyNi0xMC0zMDswODoyNDoyOSBQTTsxOzA="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="count, a, b, i, nxt" type="Integer" array="False" size=""/>
            <output expression="&quot;How many?&quot;" newline="True"/>
            <input variable="count"/>
            <assign variable="a" expression="0"/>
            <assign variable="b" expression="1"/>
            <for variable="i" start="0" end="count - 1" direction="inc" step="1">
                <output expression="a &amp; &quot; &quot;" newline="False"/>
                <assign variable="nxt" expression="a + b"/>
                <assign variable="a" expression="b"/>
                <assign variable="b" expression="nxt"/>
            </for>
            <output expression="&quot;&quot;" newline="True"/>
            <output expression="&quot;fib(&quot; &amp; count &amp; &quot;) = &quot; &amp; fib(count)" newline="True"/>
        </body>
    </function>
    <function name="fib" type="Integer" variable="result">
        <parameters>
            <parameter name="n" type="Integer" array="False"/>
        </parameters>
        <body>
            <declare name="result" type="Integer" array="False" size=""/>
            <if expression="n &lt; 2">
                <then>
                    <assign variable="result" expression="n"/>
                </then>
                <else>
                    <assign variable="result" expression="fib(n - 1) + fib(n - 2)"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
