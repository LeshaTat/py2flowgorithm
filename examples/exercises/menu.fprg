<?xml version="1.0"?>
<flowgorithm fileversion="3.0">
    <attributes>
        <attribute name="name" value="Menu"/>
        <attribute name="authors" value="alekseitatuzov"/>
        <attribute name="about" value="Menu.&#13;&#10;&#13;&#10;A small calculator driven by a menu."/>
        <attribute name="saved" value="2026-10-30 08:24:29 PM"/>
        <attribute name="created" value="YWxla3NlaXRhdHV6b3Y7QWxla3NlaXMtTWFjQm9vay1Qcm87MjAyNi0xMC0zMDswODoyNDoyOSBQTTsw"/>
        <attribute name="edited" value="YWxla3NlaXRhdHV6b3Y7QWxla3NlaXMtTWFjQm9vay1Qcm87MjAyNi0xMC0zMDswODoyNDoyOSBQTTsxOzA="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="choice" type="Integer" array="False" size=""/>
            <declare name="a, b" type="Real" array="False" size=""/>
            <do expression="choice != 0">
                <call expression="showMenu()"/>
                <input variable="choice"/>
                <if expression="choice == 1">
                    <then>
                        <assign variable="a" expression="ask(&quot;a?&quot;)"/>
                        <assign variable="b" expression="ask(&quot;b?&quot;)"/>
                        <output expression="a &amp; &quot; + &quot; &amp; b &amp; &quot; = &quot; &amp; a + b" newline="True"/>
                    </then>
                    <else>
                        <if expression="choice == 2">
                            <then>
                                <assign variable="a" expression="ask(&quot;a?&quot;)"/>
                                <assign variable="b" expression="ask(&quot;b?&quot;)"/>
                                <output expression="a &amp; &quot; * &quot; &amp; b &amp; &quot; = &quot; &amp; a * b" newline="True"/>
                            </then>
                            <else>
                                <if expression="choice == 3">
                                    <then>
                                        <assign variable="a" expression="ask(&quot;base?&quot;)"/>
                                        <assign variable="b" expression="ask(&quot;exponent?&quot;)"/>
                                        <output expression="a &amp; &quot; ^ &quot; &amp; b &amp; &quot; = &quot; &amp; a ^ b" newline="True"/>
                                    </then>
                                    <else>
                                        <if expression="choice != 0">
                                            <then>
                                                <output expression="&quot;Unknown choice&quot;" newline="True"/>
                                            </then>
                                            <else/>
                                        </if>
                                    </else>
                                </if>
                            </else>
                        </if>
                    </else>
                </if>
            </do>
            <output expression="&quot;Bye&quot;" newline="True"/>
        </body>
    </function>
    <function name="showMenu" type="None" variable="">
        <parameters/>
        <body>
            <output expression="&quot;1) add  2) multiply  3) power  0) quit&quot;" newline="True"/>
        </body>
    </function>
    <function name="ask" type="Real" variable="value">
        <parameters>
            <parameter name="prompt" type="String" array="False"/>
        </parameters>
        <body>
            <declare name="value" type="Real" array="False" size=""/>
            <output expression="prompt" newline="True"/>
            <input variable="value"/>
        </body>
    </function>
</flowgorithm>
