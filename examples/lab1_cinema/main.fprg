<?xml version="1.0"?>
<flowgorithm fileversion="3.0">
    <attributes>
        <attribute name="name" value="Cinema Seats"/>
        <attribute name="authors" value="alekseitatuzov"/>
        <attribute name="about" value="Cinema Seats.&#13;&#10;&#13;&#10;Lab 1 (Grade 9, Flowgorithm arrays). A small cinema has 10 seats, numbered 1 to 10. The Boolean&#13;&#10;array booked says which seats are taken (seat 1 is at index 0); seats 2, 5 and 7 are booked at&#13;&#10;the start. A menu shows the seats until the user quits."/>
        <attribute name="saved" value="2026-11-01 07:15:31 PM"/>
        <attribute name="created" value="YWxla3NlaXRhdHV6b3Y7QWxla3NlaXMtTWFjQm9vay1Qcm87MjAyNi0xMS0wMTswNzoxNTozMSBQTTsw"/>
        <attribute name="edited" value="YWxla3NlaXRhdHV6b3Y7QWxla3NlaXMtTWFjQm9vay1Qcm87MjAyNi0xMS0wMTswNzoxNTozMSBQTTsxOzA="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="SEATS, fill, SHOW, QUIT, choice" type="Integer" array="False" size=""/>
            <assign variable="SEATS" expression="10"/>
            <assign variable="SHOW" expression="1"/>
            <assign variable="QUIT" expression="2"/>
            <declare name="booked" type="Boolean" array="True" size="SEATS"/>
            <for variable="fill" start="0" end="SEATS - 1" direction="inc" step="1">
                <assign variable="booked[fill]" expression="false"/>
            </for>
            <comment text="at the start seats 2, 5 and 7 are booked"/>
            <call expression="book(booked, 2)"/>
            <call expression="book(booked, 5)"/>
            <call expression="book(booked, 7)"/>
            <do expression="choice != QUIT">
                <call expression="showMenu()"/>
                <assign variable="choice" expression="readNumber(&quot;Choice?&quot;, SHOW, QUIT, &quot;Invalid choice&quot;)"/>
                <if expression="choice == SHOW">
                    <then>
                        <call expression="showMap(booked)"/>
                    </then>
                    <else/>
                </if>
            </do>
            <output expression="&quot;Goodbye&quot;" newline="True"/>
        </body>
    </function>
    <function name="readNumber" type="Integer" variable="number">
        <parameters>
            <parameter name="prompt" type="String" array="False"/>
            <parameter name="low" type="Integer" array="False"/>
            <parameter name="high" type="Integer" array="False"/>
            <parameter name="complaint" type="String" array="False"/>
        </parameters>
        <body>
            <comment text="Ask until the answer is a number from low to high, saying `complaint` after each other one."/>
            <declare name="number" type="Integer" array="False" size=""/>
            <output expression="prompt" newline="True"/>
            <input variable="number"/>
            <while expression="number &lt; low or number &gt; high">
                <output expression="complaint" newline="True"/>
                <input variable="number"/>
            </while>
        </body>
    </function>
    <function name="showMenu" type="None" variable="">
        <parameters/>
        <body>
            <output expression="&quot;1 Show seats&quot;" newline="True"/>
            <output expression="&quot;2 Quit&quot;" newline="True"/>
        </body>
    </function>
    <function name="book" type="None" variable="">
        <parameters>
            <parameter name="booked" type="Boolean" array="True"/>
            <parameter name="seat" type="Integer" array="False"/>
        </parameters>
        <body>
            <assign variable="booked[seat - 1]" expression="true"/>
        </body>
    </function>
    <function name="seatMap" type="String" variable="line">
        <parameters>
            <parameter name="booked" type="Boolean" array="True"/>
        </parameters>
        <body>
            <comment text="The seats on one line, each as its index, a colon and X (booked) or - (free)."/>
            <declare name="line, mark" type="String" array="False" size=""/>
            <declare name="SEATS, i" type="Integer" array="False" size=""/>
            <assign variable="SEATS" expression="10"/>
            <assign variable="line" expression="&quot;&quot;"/>
            <for variable="i" start="0" end="SEATS - 1" direction="inc" step="1">
                <if expression="i &gt; 0">
                    <then>
                        <assign variable="line" expression="line &amp; &quot; &quot;"/>
                    </then>
                    <else/>
                </if>
                <if expression="booked[i]">
                    <then>
                        <assign variable="mark" expression="&quot;X&quot;"/>
                    </then>
                    <else>
                        <assign variable="mark" expression="&quot;-&quot;"/>
                    </else>
                </if>
                <assign variable="line" expression="line &amp; ToString(i) &amp; &quot;:&quot; &amp; mark"/>
            </for>
        </body>
    </function>
    <function name="showMap" type="None" variable="">
        <parameters>
            <parameter name="booked" type="Boolean" array="True"/>
        </parameters>
        <body>
            <output expression="seatMap(booked)" newline="True"/>
        </body>
    </function>
</flowgorithm>
