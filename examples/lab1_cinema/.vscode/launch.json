{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Convert to Flowgorithm",
            "type": "debugpy",
            "request": "launch",
            "module": "py2fprg",
            "args": [".", "--lint"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Play main.py",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        }
    ]
}
