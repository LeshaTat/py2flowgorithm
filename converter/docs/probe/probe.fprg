<?xml version="1.0"?>
<flowgorithm fileversion="3.0">
    <attributes>
        <attribute name="name" value="Probe: run-time rules"/>
        <attribute name="authors" value="py2fprg"/>
        <attribute name="about" value="Run me once in Flowgorithm and compare the console with expected.txt."/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="i, n, rounds" type="Integer" array="False" size=""/>
            <declare name="ok" type="Boolean" array="False" size=""/>
            <output expression="&quot;A1 &quot; &amp; (7 / 3)" newline="True"/>
            <output expression="&quot;A2 &quot; &amp; (0.1 + 0.2)" newline="True"/>
            <output expression="&quot;A3 &quot; &amp; (2 / 3)" newline="True"/>
            <output expression="&quot;A4 &quot; &amp; (10.0 ^ 15)" newline="True"/>
            <output expression="&quot;A5 &quot; &amp; (123456789.0 * 10000000)" newline="True"/>
            <output expression="&quot;A6 &quot; &amp; (1 / 3 * 3)" newline="True"/>
            <output expression="&quot;A7 &quot; &amp; (0.1 * 0.0001)" newline="True"/>
            <output expression="&quot;B1 &quot; &amp; (ToFixed(2.25, 1))" newline="True"/>
            <output expression="&quot;B2 &quot; &amp; (ToFixed(-2.25, 1))" newline="True"/>
            <output expression="&quot;B3 &quot; &amp; (ToFixed(0.125, 2))" newline="True"/>
            <output expression="&quot;B4 &quot; &amp; (ToFixed(2.675, 2))" newline="True"/>
            <output expression="&quot;B5 &quot; &amp; (ToFixed(1.005, 2))" newline="True"/>
            <output expression="&quot;D1 &quot; &amp; (2 ^ 3 ^ 2)" newline="True"/>
            <output expression="&quot;D2 &quot; &amp; (-2 ^ 2)" newline="True"/>
            <output expression="&quot;D3 &quot; &amp; (2 ^ -1)" newline="True"/>
            <output expression="&quot;G1 before&quot;" newline="True"/>
            <assign variable="ok" expression="false and Probe(1)"/>
            <output expression="&quot;G1 after&quot;" newline="True"/>
            <output expression="&quot;G2 before&quot;" newline="True"/>
            <assign variable="ok" expression="true or Probe(2)"/>
            <output expression="&quot;G2 after&quot;" newline="True"/>
            <for variable="i" start="1" end="3" direction="inc" step="1"/>
            <output expression="&quot;H1 &quot; &amp; (i)" newline="True"/>
            <assign variable="n" expression="3"/>
            <assign variable="rounds" expression="0"/>
            <for variable="i" start="1" end="n" direction="inc" step="1">
                <assign variable="n" expression="n - 1"/>
                <assign variable="rounds" expression="rounds + 1"/>
            </for>
            <output expression="&quot;H2 &quot; &amp; (rounds)" newline="True"/>
            <for variable="i" start="3" end="1" direction="dec" step="1"/>
            <output expression="&quot;H3 &quot; &amp; (i)" newline="True"/>
            <output expression="&quot;I1 &quot; &amp; (Int(-3.7))" newline="True"/>
            <output expression="&quot;I5 &quot; &amp; (Sgn(-0.5))" newline="True"/>
            <output expression="&quot;Z end&quot;" newline="True"/>
        </body>
    </function>
    <function name="Probe" type="Boolean" variable="result">
        <parameters>
            <parameter name="n" type="Integer" array="False"/>
        </parameters>
        <body>
            <declare name="result" type="Boolean" array="False" size=""/>
            <output expression="&quot;    Probe(&quot; &amp; n &amp; &quot;) was evaluated&quot;" newline="True"/>
            <assign variable="result" expression="true"/>
        </body>
    </function>
</flowgorithm>
