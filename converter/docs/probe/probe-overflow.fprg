<?xml version="1.0"?>
<flowgorithm fileversion="3.0">
    <attributes>
        <attribute name="name" value="Probe: Integer size"/>
        <attribute name="authors" value="py2fprg"/>
        <attribute name="about" value="How big can an Integer get?"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="big" type="Integer" array="False" size=""/>
            <assign variable="big" expression="2147483647"/>
            <assign variable="big" expression="big + 1"/>
            <output expression="&quot;L1 &quot; &amp; (big)" newline="True"/>
            <assign variable="big" expression="9223372036854775807"/>
            <output expression="&quot;L2 &quot; &amp; (big)" newline="True"/>
            <assign variable="big" expression="big + 1"/>
            <output expression="&quot;L3 &quot; &amp; (big)" newline="True"/>
            <output expression="&quot;Z end&quot;" newline="True"/>
        </body>
    </function>
</flowgorithm>
