<?xml version="1.0"?>
<flowgorithm fileversion="3.0">
    <attributes>
        <attribute name="name" value="Probe: array start values"/>
        <attribute name="authors" value="py2fprg"/>
        <attribute name="about" value="Does a new array start out as 0, or is it empty?"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <output expression="&quot;A11 &quot; &amp; (Sqrt(2) * Sqrt(2))" newline="True"/>
            <output expression="&quot;Z end&quot;" newline="True"/>
        </body>
    </function>
</flowgorithm>
